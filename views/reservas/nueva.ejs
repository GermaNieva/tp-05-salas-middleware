<p class="seccion"><%= seccion %></p>

<h1>Reservar una sala</h1>

<% if (error) { %>
  <p class="error" role="alert"><%= error %></p>
<% } %>

<p class="texto-guia">
  La reserva queda guardada solamente mientras el servidor está encendido.
</p>

<form class="formulario" action="/reservas" method="post">
  <p>
    <label for="estudiante">Nombre del estudiante</label>
    <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante %>" />
  </p>

  <p>
    <label for="email">Email</label>
    <input type="text" id="email" name="email" value="<%= valores.email %>" />
  </p>

  <p>
    <label for="sala">Sala</label>
    <select id="sala" name="sala">
      <option value="">Elegir una sala</option>
      <% salas.forEach(function (unaSala) { %>
        <option value="<%= unaSala %>" <% if (valores.sala === unaSala) { %>selected<% } %>><%= unaSala %></option>
      <% }); %>
    </select>
  </p>

  <p>
    <label for="fecha">Fecha</label>
    <input type="date" id="fecha" name="fecha" value="<%= valores.fecha %>" />
  </p>

  <p>
    <label for="turno">Turno</label>
    <select id="turno" name="turno">
      <option value="">Elegir un turno</option>
      <% turnos.forEach(function (unTurno) { %>
        <option value="<%= unTurno %>" <% if (valores.turno === unTurno) { %>selected<% } %>><%= unTurno %></option>
      <% }); %>
    </select>
  </p>

  <p>
    <label for="personas">Cantidad de personas (de 1 a 6)</label>
    <input type="number" id="personas" name="personas" min="1" max="6" value="<%= valores.personas %>" />
  </p>

  <p>
    <button class="boton" type="submit">Guardar la reserva</button>
  </p>
</form>

<p>
  <a href="/reservas">Volver al listado</a>
</p>
